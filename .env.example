# URL publique du panel / API, sans slash final.
# Exemple Hostinger : https://admin.tondomaine.com
NEXT_PUBLIC_SITE_URL=http://localhost:3020

# Conteneur / Hostinger : laisser PORT à la plateforme, forcer l'écoute.
# HOSTNAME=0.0.0.0
# PORT=3000

# Mot de passe admin (≥ 12 caractères).
ADMIN_PASSWORD=

# Secret HMAC session admin (≥ 32 caractères).
ADMIN_SESSION_SECRET=

# Secrets des sites qui envoient des stats (optionnel).
# SITE_SECRET_AUDIOVA=
# SITE_SECRET_VIDEOVA=
# SITE_SECRET_OMNAWORKS=

